GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_ENABLED=false
AI_MAX_CALLS_PER_RUN=3
AI_MAX_CALLS_PER_DAY=15
AI_CACHE_ENABLED=true
DATABASE_PATH=data/app/marketing_intelligence.db
KEEP_LAST_RUNS=20
AI_MAX_MAPPING_CALLS_PER_DAY=10
# Deployment (public demo) only: set PUBLIC_MODE=true in the host's secrets
PUBLIC_MODE=false
MAX_UPLOAD_MB_PUBLIC=10
AI_MAX_CALLS_PER_SESSION=2
AI_MAX_MAPPING_CALLS_PER_SESSION=2
EXPORTS_DIR=exports
MAX_UPLOAD_MB=50
LARGE_ROW_WARNING=200000
# Remember confirmed column names for the next file (always off when PUBLIC_MODE=true)
LEARNING_ENABLED=true

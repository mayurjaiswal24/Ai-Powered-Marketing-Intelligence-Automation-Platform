# Keep generated data byte-identical to the generator output on every OS.
data/sample/*.csv text eol=lf
data/sample/*.json text eol=lf
data/sample/*.xlsx binary
# Loader test fixtures must keep their exact bytes (encodings, line endings, fake binaries).
tests/fixtures/* -text
tests/fixtures/*.py text eol=lf

# Windows batch files must keep CRLF line endings.
*.bat text eol=crlf

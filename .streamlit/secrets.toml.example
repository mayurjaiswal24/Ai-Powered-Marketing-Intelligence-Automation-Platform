# Settings for the hosted app (Streamlit Community Cloud -> your app -> Settings -> Secrets).
# Copy everything below into the "Secrets" box and replace the placeholder key.
# NEVER commit a real secrets.toml: .streamlit/secrets.toml is git-ignored.
# Locally the app reads the same settings from the .env file instead (see .env.example).
# Values are written as text in quotes; the app reads "true"/"false" and numbers from text.

# --- Google Gemini ---------------------------------------------------------------------------
GEMINI_API_KEY = "paste-your-key-here"          # from Google AI Studio; keep it secret
GEMINI_MODEL = "gemini-3.5-flash"               # main model
GEMINI_FALLBACK_MODEL = "gemini-3.1-flash-lite" # used once when the main model is overloaded
AI_ENABLED = "true"                             # "false" = the app works fully without AI
AI_CACHE_ENABLED = "true"                       # reuse saved answers (no repeated calls)

# --- AI limits (protect the free tier) --------------------------------------------------------
AI_MAX_CALLS_PER_RUN = "3"                # insight calls per analysis run
AI_MAX_CALLS_PER_DAY = "15"               # insight calls per day (UTC), all visitors together
AI_MAX_CALLS_PER_SESSION = "2"            # insight calls per visitor session (public mode)
AI_MAX_MAPPING_CALLS_PER_DAY = "10"       # field-mapping calls per day (UTC)
AI_MAX_MAPPING_CALLS_PER_SESSION = "2"    # field-mapping calls per visitor session (public mode)

# --- Public demo ------------------------------------------------------------------------------
PUBLIC_MODE = "true"          # each visitor sees only their own analyses; runs deleted after 24 h
KEEP_LAST_RUNS = "20"         # at most this many analyses are kept in the database
MAX_UPLOAD_MB_PUBLIC = "10"   # upload limit in public mode
MAX_UPLOAD_MB = "50"          # upload limit when PUBLIC_MODE is "false"
LARGE_ROW_WARNING = "200000"  # warn that very large files may be slow

# --- Storage (defaults are right for Streamlit Community Cloud) -------------------------------
DATABASE_PATH = "data/app/marketing_intelligence.db"
EXPORTS_DIR = "exports"
